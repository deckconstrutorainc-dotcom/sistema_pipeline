# Supabase - configuração da instância do projeto BTS Pipe
#
# Variáveis NEXT_PUBLIC_* são expostas ao bundle do navegador.
# Use somente valores seguros para exposição pública (URL do projeto e anon key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUNCA exponha esta chave no navegador/client bundle.
# SUPABASE_SERVICE_ROLE_KEY deve ser usada SOMENTE em código server-side
# (Route Handlers, Server Actions, Server Components, jobs/functions),
# nunca em componentes client ("use client") nem em variáveis NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública da aplicação, usada para montar links de callback (ex.: link
# de recuperação de senha). Opcional em dev — tem fallback para
# http://localhost:3000 quando não definida.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# M3/M7/M8 — Automação/Ecosystem/Intelligence: segredo exigido para chamar
# POST|GET /api/automations/process e POST|GET /api/ai/process (processam a
# fila de jobs: automation_runs, webhook_deliveries e ai_runs). NUNCA
# hardcode este valor no código. Sem esta variável definida, as rotas
# recusam qualquer chamada (fail-closed).
#
# `vercel.json` (raiz do repo) já declara essas duas rotas como Vercel Cron
# Jobs. Se o projeto estiver na Vercel e esta env var estiver configurada
# com o nome EXATO `CRON_SECRET`, a Vercel injeta automaticamente o header
# `Authorization: Bearer <CRON_SECRET>` nas chamadas de cron (GET) — as
# rotas aceitam esse esquema OU o header manual `x-cron-secret` (útil para
# testar via POST manual ou um cron externo/self-hosted).
#
# Plano Hobby da Vercel limita cron jobs a no máximo 1 execução/dia — ajuste
# o campo `schedule` em `vercel.json` conforme o plano do projeto. Fora da
# Vercel, configure um cron externo equivalente (ver comentário em
# supabase/migrations/20260818091500_jobs.sql para o racional completo de
# "sem worker/cron nativo no código").
CRON_SECRET=

# M7 — Ecosystem: chave de criptografia server-only usada para
# criptografar/decriptar segredos de integrações/webhooks
# (`integration_credentials.secret_ciphertext`, `webhooks.secret_ciphertext`
# — ver `src/lib/crypto/secret-encryption.ts` e o comentário em
# `supabase/migrations/20260818094500_integration_credentials.sql` para o
# racional completo de "criptografia em camada de aplicação, não no
# banco").
#
# Deve decodificar (base64 OU hex) para exatamente 32 bytes (AES-256).
# Gerar uma nova chave com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# NUNCA commite o valor real. Em produção, configure como env var segura no
# provedor de deploy (ex.: Vercel), nunca em .env versionado.
#
# ROTAÇÃO (pendência real, não implementada): trocar esta chave invalida a
# decriptação de TODOS os segredos já persistidos — uma rotação segura
# exigiria re-criptografar todas as linhas de integration_credentials/
# webhooks com a chave nova antes de trocar a variável em produção
# (migração de dados, não uma migration de schema). Um KMS gerenciado
# (Supabase Vault, AWS KMS) resolveria isso de forma nativa — fora do
# escopo deste milestone.
ENCRYPTION_KEY=

# M8 — Intelligence: chave da API da Anthropic, usada por
# `src/lib/ai/providers/anthropic-provider.ts` para chamar a Messages API
# (CLAUDE.md §17 — camada de IA desacoplada). SERVER-ONLY: NUNCA prefixe com
# NEXT_PUBLIC_*, nunca importe o provider de um componente "use client".
# Sem esta variável configurada, qualquer execução de IA falha de forma
# explícita (nunca simula uma resposta) — ver `AnthropicProvider.generate()`.
ANTHROPIC_API_KEY=

# Voz -> Card: chave da API do Google Gemini (aistudio.google.com/apikey),
# usada por `src/lib/ai/providers/gemini-provider.ts` para transcrever áudio
# e extrair automaticamente título/prazo/responsável/campos de um card a
# partir de uma gravação de voz. SERVER-ONLY: nunca prefixe com
# NEXT_PUBLIC_*, nunca importe o provider de um componente "use client".
# Sem esta variável, a funcionalidade de voz fica indisponível de forma
# explícita (nunca simula uma transcrição).
GOOGLE_API_KEY=
